{
  "name": "taller_users",
  "version": "1.0.0",
  "description": "Modulo para el taller AWS con serverless hecho para manejar las peticiones de los usuarios",
  "main": "index.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "typecheck": "tsc --noEmit",
    "deploy:dev": "serverless deploy --stage develop --aws-profile serverless_user_personal",
    "remove:dev": "serverless remove --stage develop --aws-profile serverless_user_personal",
    "deploy:prod": "serverless deploy --stage prod --aws-profile serverless_user_personal",
    "remove:prod": "serverless remove --stage prod --aws-profile serverless_user_personal"
  },
  "keywords": [
    "AWS",
    "Node.js",
    "Serverless"
  ],
  "author": "Antoni",
  "license": "ISC",
  "devDependencies": {
    "@types/aws-lambda": "^8.10.164",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.5",
    "aws-lambda": "^1.0.7",
    "serverless": "^4.45.0",
    "serverless-localstack": "^1.4.0",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@aws-sdk/lib-dynamodb": "^3.1156.0",
    "bcryptjs": "^3.0.3",
    "jsonwebtoken": "^9.0.3",
    "uuid": "^14.0.3"
  }
}
